# Copy to .env and adjust. .env is git-ignored.

# Port published on the Debian host and port the app listens on inside the container.
HOST_PORT=8888
APP_PORT=8888

ASPNETCORE_ENVIRONMENT=Production

# SQLite database file (inside the container; /data is the persistent volume ./data).
ConnectionStrings__DefaultConnection=Data Source=/data/interviewforge.db

# Seed import: Always | IfEmpty | Never  (idempotent, so Always is safe)
Import__RunOnStartup=Always
# Where the importer looks for the Markdown files. Falls back to the copies baked into the image.
Import__DataDirectory=/data

# Logging
Logging__LogLevel__Default=Information

# Set to false to skip running tests during `docker compose build`.
RUN_TESTS=true

# Required once on upgrade / first launch. Never commit .env.
# Admin login is configured in appsettings.json (Admin section); these optional values override it.
Admin__Username=admin
Admin__Email=
Admin__Password=
Admin__DisplayName=Administrator
# Persist cookie-signing keys beside SQLite across container rebuilds.
Auth__KeyDirectory=/data/keys
# Enable for HTTPS deployments; HTTP testing requires false.
Auth__SecureCookies=false
